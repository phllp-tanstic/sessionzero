# Runtime: development | test | production
SESSIONZERO_ENV=development

# Required by database commands. PostgreSQL only; no SQLite/in-memory fallback.
# Use separate databases/credentials in development, test, and production.
DATABASE_URL=postgresql+psycopg://sessionzero:change-me@127.0.0.1:5432/sessionzero_development

# Public Bitget UTA v3 API. Phase 0 requires no Bitget credentials.
BITGET_BASE_URL=https://api.bitget.com
BITGET_HTTP_TIMEOUT_SECONDS=10
BITGET_HTTP_MAX_RETRIES=2

# Comma-separated exact origins. Never use * in production.
SESSIONZERO_CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# Server-side API origin. Set to the deployed HTTPS API in production.
SESSIONZERO_API_URL=http://127.0.0.1:8000
